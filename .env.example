# Server-only TypeSafe credential. Never expose it through NUXT_PUBLIC_.
JEV_API=
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
# USD per million tokens; estimates, not a provider invoice.
JEV_INPUT_USD_PER_MILLION=0.042
JEV_OUTPUT_USD_PER_MILLION=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_INPUT_USD_PER_MILLION=0.40
OPENAI_OUTPUT_USD_PER_MILLION=1.60
# SQLite category registry persists categories, questions, and assignments.
# CATEGORY_DB_PATH=/absolute/path/categories.sqlite3
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NUXT_API_BASE=http://127.0.0.1:8000
# Optional JSON array from generate_bank_profiles.py:
# BANK_DATA_PATH=/absolute/path/profils_bancaires_synthetiques_5000.json
